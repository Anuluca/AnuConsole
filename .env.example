# Run npm run setup:admin to generate .env.local interactively.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional read-only account user. Generate with npm run setup:viewer.
VIEWER_PASSWORD_HASH=

# Optional server-only upstream; defaults to the existing Anutrium analytics service.
GA4_REPORTS_URL=https://steam-api.anuluca.com/analytics

# Server-only feature controls. Use the same random token (32+ characters) as the Worker secret.
HOME_FEATURES_URL=https://steam-api.anuluca.com/admin/home-features
HOME_FEATURES_TOKEN=

# Server-only Cloudflare token: Zone / DNS / Edit, restricted to anuluca.com.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Server-only Netlify PAT. Optional comma-separated project ID allowlist.
NETLIFY_API_TOKEN=
NETLIFY_SITE_IDS=

# Optional server-only GitHub fine-grained PAT: selected repositories, Metadata read-only.
GITHUB_API_TOKEN=

# Optional server-only likes endpoint. Uses HOME_FEATURES_TOKEN; otherwise inferred from HOME_FEATURES_URL.
# FLORA_LIKES_URL=https://steam-api.anuluca.com/admin/floratrium/likes
