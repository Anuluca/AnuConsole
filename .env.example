# Run npm run setup:admin to generate .env.local interactively.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional server-only upstream; defaults to the existing Anutrium analytics service.
GA4_REPORTS_URL=https://steam-api.anuluca.com/analytics

# Server-only feature controls. Use the same random token (32+ characters) as the Worker secret.
HOME_FEATURES_URL=https://steam-api.anuluca.com/admin/home-features
HOME_FEATURES_TOKEN=
